<li class="qie-node qie-item" data-item-id="{{id}}" data-uuid="{{uuid}}">
  <img class="qie-item-img" src="{{img}}" alt="" loading="lazy" />
  <span class="qie-item-name" data-tooltip="{{typeLabel}}">{{name}}</span>
  <span class="qie-cell qie-item-rarity">{{rarityLabel}}</span>
  <span class="qie-cell qie-item-weight">{{weightLabel}}</span>
  <span class="qie-cell qie-item-price">{{priceLabel}}</span>
</li>